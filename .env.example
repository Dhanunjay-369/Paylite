# All optional: sensible defaults exist for local development.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/paylite?sslmode=disable
REDIS_ADDR=localhost:6379
PORT=8080
WEBHOOK_SECRET=change-me
RATE_LIMIT_PER_MINUTE=600
CHARGE_TIMEOUT_MS=5000
PENDING_STALE_AFTER_MS=30000
RECONCILE_INTERVAL_MS=2000

# Demo-only. Never enable in production.
ENABLE_DEBUG=0
PROCESSOR_MODE=approve          # approve | decline | apply_then_timeout | drop_request
PROCESSOR_LATENCY_MS=0
